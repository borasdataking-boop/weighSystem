{
  "name": "phanbach-weigh-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "python3 backend/app.py",
    "server:python": "python3 backend/app.py",
    "server:node": "node backend/node/dist/server.cjs",
    "server:node:build": "npx esbuild backend/node/src/server.ts --bundle --platform=node --outfile=backend/node/dist/server.cjs --external:pg-native",
    "db:init": "/opt/homebrew/opt/postgresql@18/bin/psql -U phanbach -d weigh_dashboard -f database/init_db.sql",
    "db:seed": "node database/seed_db.cjs",
    "db:seed:py": "python3 database/seed_data.py",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
