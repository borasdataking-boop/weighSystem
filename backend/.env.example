# ==============================================================================
# WEIGH DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection URL:
# 1. Zero-config SQLite (Khuyên dùng cho PythonAnywhere Free Tier để chạy ngay lập tức):
DATABASE_URL=sqlite:///database/weigh_dashboard.db

# 2. Hoặc PostgreSQL (Supabase, Neon, AWS RDS, hoặc PostgreSQL trả phí):
# DATABASE_URL=postgresql://phanbach:password@localhost:5432/weigh_dashboard

# Server Port (Dùng khi chạy standalone / local development)
PORT=5001

# Flask Environment (development / production)
FLASK_ENV=production
SECRET_KEY=weigh-dashboard-secret-key-change-in-production
